{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "edubridgez-firebase-adminsdk-*.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/teacher/:username",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
